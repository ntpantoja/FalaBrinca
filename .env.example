# Nunca envie chaves secretas ao GitHub ou ao chat.
# Vercel: Configurações → Variáveis de ambiente; depois reimplante.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. Nunca use prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=
# Comece pelo modo de teste do Stripe.
STRIPE_SECRET_KEY=
# Preços exatos em BRL; mensal e anual são validados no servidor.
# Recorrente mensal R$ 50,00.
STRIPE_PRICE_ID=
# Recorrente anual R$ 450,00, cobrado de uma vez por ano.
STRIPE_ANNUAL_PRICE_ID=
# Legado opcional: mantenha somente se já houve vendas/checkouts do passe retirado.
# Não é necessário configurar para novas vendas; só preserva confirmações antigas.
STRIPE_YEAR_PASS_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# ID UUID da sua conta confirmada em Supabase → Autenticação → Usuários.
# Configuração somente do servidor. Não é e-mail nem senha e não usa NEXT_PUBLIC_.
MASTER_USER_ID=

# Opcional: teste privado de compra de R$ 5/mês. Não altera os planos públicos.
# Ativa para MASTER_USER_ID por padrão quando o preço está configurado.
STRIPE_TEST_PRICE_ID=
# Opcional: UUID de outra conta confirmada para testar liberação de acesso de assinante.
BILLING_TEST_USER_ID=
# false bloqueia novas compras de teste. Não cancela assinaturas já criadas.
BILLING_TEST_ENABLED=
